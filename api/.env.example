# AnimeTadka API — environment configuration
# Copy to .env and adjust.

# --- Source site ---
BASE_URL=https://animetadka.com

# --- HTTP client ---
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
HTTP_TIMEOUT=15
HTTP_CONNECT_TIMEOUT=7
HTTP_MAX_RETRIES=1
HTTP_RETRY_BACKOFF_MS=600
REQUEST_DELAY_MS=0
HTTP_PROXY=
# Resolve source-site hostnames to IPv4 only — avoids dual-stack DNS
# resolution timeouts (cURL error 28) on IPv6-broken networks.
HTTP_IPRESOLVE_V4=true

# --- Caching ---
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_DIR=storage/cache

# --- HTML snapshot storage ---
HTML_DIR=storage/html

# --- Logging ---
LOG_DIR=storage/logs
LOG_LEVEL=info

# --- API ---
API_DEBUG=false